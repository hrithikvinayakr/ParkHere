{
  "expo": {
    "name": "ParkHere",
    "slug": "parkhere",
    "scheme": "parkhere",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.parkhere.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.parkhere.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ParkHere uses your location to show parking nearby and to pin your spot on the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ParkHere needs your photos so you can add pictures of your parking spot.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
