# Copy to .env and fill in. Values come from `pnpm db:start` (local) or your
# Supabase project's API settings (hosted). Both are safe to ship in the app:
# the publishable key only grants what Row Level Security allows.
#
# Android emulator: use http://10.0.2.2:54321 to reach your computer's localhost.
# Physical phone: use your computer's LAN IP, e.g. http://192.168.1.20:54321
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
